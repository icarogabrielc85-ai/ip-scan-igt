<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?ifndef AppVersion?>
  <?define AppVersion="2.12.5"?>
  <?endif?>
  <Product Id="*" Name="IP Scan IGT" Language="1046" Version="$(var.AppVersion)" Manufacturer="IGT" UpgradeCode="8B4294F9-3B75-4CE3-B9E2-7BE34947E97A">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64" Description="Instalador do IP Scan IGT para Windows" />
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do IP Scan IGT já está instalada no computador." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/icarogabrielc85-ai/ip-scan-igt" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="IP Scan IGT" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="IP Scan IGT" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="C1A5C132-7212-4217-9104-569A5E0B3C21" Win64="yes">
        <File Id="IPScanIGTEXE" Source="dist\IPScanIGT.exe" KeyPath="yes" />
      </Component>
      <Component Id="MacVendorsFile" Guid="D2A5C132-7212-4217-9104-569A5E0B3C22" Win64="yes">
        <File Id="MacVendorsTXT" Source="mac-vendors.txt" KeyPath="yes" />
      </Component>
      <Component Id="AppIconPNG" Guid="E3A5C132-7212-4217-9104-569A5E0B3C23" Win64="yes">
        <File Id="AppIconPNGFile" Source="icon.png" KeyPath="yes" />
      </Component>
      <Component Id="AppIconICO" Guid="F4A5C132-7212-4217-9104-569A5E0B3C24" Win64="yes">
        <File Id="AppIconICOFile" Source="icon.ico" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="71A5C132-7212-4217-9104-569A5E0B3C25">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="IP Scan IGT"
                  Description="Scanner de Rede Local e Diagnóstico"
                  Target="[INSTALLFOLDER]IPScanIGT.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\IGT\IPScanIGT" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="ApplicationDesktopShortcut" Guid="81A5C132-7212-4217-9104-569A5E0B3C26">
        <Shortcut Id="ApplicationDesktopShortcutFile"
                  Name="IP Scan IGT"
                  Description="Scanner de Rede Local e Diagnóstico"
                  Target="[INSTALLFOLDER]IPScanIGT.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\IGT\IPScanIGT" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="IP Scan IGT" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="MacVendorsFile" />
      <ComponentRef Id="AppIconPNG" />
      <ComponentRef Id="AppIconICO" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ApplicationDesktopShortcut" />
    </Feature>
  </Product>
</Wix>
